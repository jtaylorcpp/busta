---
/**
 * GET /mb/<address>/folders — your folders, in sort order: rule, counts,
 * +address. Drag a row (FolderDrag) or use the arrows to reorder.
 */
import { env } from "cloudflare:workers";
import FolderPageShell from "../../../../components/app/FolderPageShell.astro";
import { Button, Icon } from "../../../../components/ui";
import { formatListDate, openMailbox } from "../../../../lib/mail-data";
import type { FolderWithCounts } from "../../../../../../src/mailbox-do";
import FolderDrag from "../../../../components/islands/FolderDrag";

const { userId, orgId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/sign-in");
if (!orgId) return Astro.redirect("/");
const access = await openMailbox(env, { userId, orgId }, Astro.params.address!);
if (!access.ok) return new Response(access.message, { status: access.status });
const { address, stub } = access;
Astro.response.headers.set("cache-control", "no-store");
const folders = (await stub.listFolders()) as FolderWithCounts[];
const b = `/mb/${encodeURIComponent(address)}`;
const [local, domain] = address.split("@");
---
<FolderPageShell title="Folders" address={address} backHref={b} backLabel="Messages">
  <Button slot="actions" variant="primary" href={`${b}/folders/new`}>+ New folder</Button>
  {folders.length === 0 ? (
    <div class="empty">
      <p><b>No folders yet.</b> Create one and describe in plain English what belongs in it. New mail is sorted as it arrives.</p>
      <Button variant="primary" href={`${b}/folders/new`}>+ New folder</Button>
    </div>
  ) : (
    <ol class="list" aria-label="Folders, in sort order" data-folder-order={`${b}/folders/order`}>
      {folders.map((f, i) => (
        <li class="item" data-name={f.name} draggable="true" tabindex="0" aria-label={`${f.name}. Drag, or press Alt and an arrow key, to reorder.`}>
          <span class="grip" aria-hidden="true"><Icon name="grip" size={16} /></span>
          <span class="rank" data-rank>{i + 1}</span>
          <div class="order">
            <form method="post" action={`${b}/folders/${f.id}/move?dir=up`}><button type="submit" data-up disabled={i === 0} aria-label={`Move ${f.name} up`}>↑</button></form>
            <form method="post" action={`${b}/folders/${f.id}/move?dir=down`}><button type="submit" data-down disabled={i === folders.length - 1} aria-label={`Move ${f.name} down`}>↓</button></form>
          </div>
          <div class="body">
            <a class="name" href={`${b}?folder=${f.id}`}>{f.name}</a>
            {f.rule ? <p class="rule">{f.rule}</p> : <p class="rule none">No rule. Only +address mail lands here.</p>}
            <div class="meta">
              <span>{f.total} message{f.total === 1 ? "" : "s"}{f.unread ? ` · ${f.unread} unread` : ""}</span>
              {f.plus_label && <code>{local}+{f.plus_label}@{domain}</code>}
              <span>{f.sorted_at ? `Last sorted ${formatListDate(f.sorted_at)}` : "Not re-sorted yet"}</span>
            </div>
          </div>
          <a class="edit" href={`${b}/folders/${f.id}`}><Icon name="pen" size={14} />Edit</a>
        </li>
      ))}
    </ol>
  )}
  <p class="note"><b>Order is the sort order.</b> Busta checks your folders top to bottom and files each email in the <b>first</b> one it fits (75% or more), so put narrow folders above broad ones. Drag a folder, or use the arrows; new folders go to the bottom. A +address match wins at once, and mail you filed by hand never moves. If no folder reaches 75%, the best guess stays in Messages as "Unsure" for you to decide. A new order applies to new mail right away.</p>
  {folders.length > 0 && (
    <form class="resort" method="post" action={`${b}/folders/resort`}>
      <Button variant="secondary" type="submit">Sort mail again</Button>
      <span>Sorts the last 30 days again in this order, in every account. Mail you filed by hand never moves. You can undo it.</span>
    </form>
  )}
</FolderPageShell>
<FolderDrag client:idle />

<style>
  .list { list-style: none; margin: 0; padding: 0; }
  .item { display: grid; grid-template-columns: auto auto auto 1fr auto; gap: var(--space-3); cursor: grab; align-items: start; padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); }
  .order { display: grid; gap: 2px; }
  .grip { color: var(--faint); padding-top: 4px; }
  .rank { width: 24px; height: 24px; margin-top: 2px; border-radius: 50%; display: grid; place-items: center; font: 700 12px var(--font-sans); background: var(--surface-2); color: var(--muted); font-variant-numeric: tabular-nums; }
  .item:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
  .item.dragging { opacity: .45; }
  .item.drop-before { box-shadow: inset 0 3px 0 var(--primary); }
  .item.drop-after { box-shadow: inset 0 -3px 0 var(--primary); }
  .list[aria-busy="true"] { opacity: .8; }
  .resort { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; padding: 0 var(--space-5) var(--space-5); font-size: var(--text-xs); color: var(--muted); }
  .note b { color: var(--text); font-weight: 600; }
  .order form { display: contents; }
  .order button { width: 26px; height: 22px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--muted); cursor: pointer; font-size: 12px; }
  .order button:disabled { opacity: .35; cursor: default; }
  .body { display: grid; gap: 4px; min-width: 0; }
  .name { font-weight: 600; color: var(--text); text-decoration: none; }
  .name:hover { color: var(--primary); }
  .rule { margin: 0; font-size: var(--text-sm); color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rule.none { font-style: italic; }
  .meta { display: flex; gap: var(--space-3); flex-wrap: wrap; font-size: var(--text-xs); color: var(--muted); }
  code { font-family: var(--font-mono); }
  .edit { display: inline-flex; gap: 5px; align-items: center; font-size: var(--text-sm); color: var(--primary); text-decoration: none; padding: 5px 10px; border-radius: var(--radius-pill); }
  .edit:hover { background: var(--surface-2); }
  .empty { display: grid; gap: var(--space-3); justify-items: start; padding: var(--space-6) var(--space-5); }
  .empty p { margin: 0; color: var(--muted); }
  .note { margin: 0; padding: var(--space-4) var(--space-5); font-size: var(--text-xs); color: var(--muted); max-width: 72ch; }
</style>
