---
/**
 * GET /mb/<address>/<message-id>: the whole conversation around one
 * message, as a chat. Other people's mail is on the left and ours on the
 * right, with dividers wherever To/Cc/Bcc changed.
 *
 * Read-only apart from marking the thread read. Star, trash, unread and
 * reply all post to the original handlers. HTML bodies come from the
 * original /body endpoint (sanitized, strict CSP) in a sandboxed frame.
 */
import { env } from "cloudflare:workers";
import AppShell from "../../../layouts/AppShell.astro";
import {
  Attachment, AudienceDivider, Banner, ChatComposer, ChatMessage, DayDivider, ThreadHeader, ThreadInfo,
} from "../../../components/ui";
import MailboxNav from "../../../components/app/MailboxNav.astro";
import ThreadFolder from "../../../components/app/ThreadFolder.astro";
import WhyNot from "../../../components/islands/WhyNot";
import "../../../styles/why.css";
import AccountMenu from "../../../components/app/AccountMenu.astro";
import { audienceChanges } from "../../../lib/audience";
import { ALL, listAccounts } from "../../../lib/accounts";
import {
  base, deliveryStatus, folderView, formatDay, formatSize, formatTime, loadThread, openMailbox, splitQuoted,
} from "../../../lib/mail-data";

const { userId, orgId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/sign-in");
if (!orgId) return Astro.redirect("/");

const id = Astro.params.id!;
const access = await openMailbox(env, { userId, orgId }, Astro.params.address!);
if (!access.ok) return new Response(access.message, { status: access.status });
const { address, stub } = access;
Astro.response.headers.set("cache-control", "no-store");

const loaded = await loadThread(env, stub, address, id);
if (!loaded) return new Response("Message not found", { status: 404 });
const folders = (await stub.listFolders()) as { id: string; name: string }[];

const { entries, names, focus, threadId } = loaded;
const self = address.toLowerCase();
const b = base(address);
// With 2+ accounts, the thread says whose it is and goes back to all mail.
const accounts = await listAccounts(env, orgId);
const account = accounts.length > 1 ? accounts.find((a) => a.address === address) ?? null : null;
// A disconnected Gmail account is read-only: it can't send as itself.
const readOnly = (await stub.sendingAs()) === "gmail-off";
const url = Astro.url;
const showImages = url.searchParams.get("images") === "1";
const ok = url.searchParams.get("ok");
const error = url.searchParams.get("error");
const warn = url.searchParams.get("warn");
const displayName = (a: string) => (a === self ? "You" : names[a] ?? a);

const changes = audienceChanges(entries.map((e) => e.envelope), self);

// Everyone on the thread (Bcc excluded: only the sender ever knew it).
const everyone = new Map<string, { name: string; address: string; self?: boolean }>();
for (const e of entries) {
  for (const a of [e.envelope.from, ...e.envelope.to, ...(e.envelope.cc ?? [])]) {
    if (!everyone.has(a)) everyone.set(a, { name: a === self ? "You" : names[a] ?? a, address: a, self: a === self });
  }
}
const people = [...everyone.values()].sort((x, y) => Number(!!x.self) - Number(!!y.self));
const tags = [...new Set(entries.map((e) => e.row.label).filter((l): l is string => !!l))];
// ?why=<folder id>: open "Why not this folder?" for this message.
const whyFolder = focus.direction === "in" ? folders.find((f) => f.id === url.searchParams.get("why")) ?? null : null;
// ?undo=<folder id>: offer to undo a rule change just made from here.
const undoFolder = folders.find((f) => f.id === url.searchParams.get("undo")) ?? null;
const focusEntry = entries.find((e) => e.row.id === id) ?? entries[entries.length - 1]!;
const subject = focusEntry.message.subject || "(no subject)";

// The composer answers ?re=<id>, or else the newest message.
const target = entries.find((e) => e.row.id === url.searchParams.get("re")) ?? entries[entries.length - 1]!;
const others = (list: string[]) => list.filter((a) => a !== self);
const directTo = target.envelope.outbound ? others(target.envelope.to) : [target.envelope.from];
const allTo = target.envelope.outbound ? others(target.envelope.to) : [target.envelope.from, ...others(target.envelope.to)];
const allCc = others(target.envelope.cc ?? []).filter((a) => !allTo.includes(a));
const multi = new Set([...allTo, ...allCc]).size > 1;
const mode = url.searchParams.get("mode") === "reply" ? "reply" : url.searchParams.get("mode") === "replyAll" || multi ? "replyAll" : "reply";
const replyTo = mode === "replyAll" ? [...new Set(allTo)] : directTo;
const replyCc = mode === "replyAll" ? [...new Set(allCc)] : [];
const replySubject = /^re:/i.test(target.message.subject) ? target.message.subject : `Re: ${target.message.subject}`;
const quote = target.message.body_text
  ? `On ${new Date(target.message.received_at).toUTCString()}, ${target.message.sender} wrote:\n` +
    target.message.body_text.split("\n").map((l) => `> ${l}`).join("\n")
  : undefined;
const modeHref = (m: string, re = target.row.id) => `?mode=${m}&re=${re}#reply`;

const bounced = entries.filter((e) => e.envelope.outbound && (e.row.delivery_status === "bounced" || e.row.delivery_status === "failed"));
---
<AppShell title={subject} mailbox={address} composeHref={`${b}/compose`} searchAction={`${b}/search`}>
  <AccountMenu slot="account" current={address} />
  <MailboxNav slot="nav" address={address} bin="messages" folderId={focus.folder_id} />

  <ThreadHeader
    backHref={account ? ALL : b}
    subject={subject}
    tags={tags}
    people={people}
    starred={!!focus.starred}
    starAction={`${b}/${id}/${focus.starred ? "unstar" : "star"}`}
    unreadAction={`${b}/${id}/unread`}
    trashAction={focus.deleted_at === null ? `${b}/${id}/trash` : undefined}
    archiveAction={focus.deleted_at === null && focus.direction === "in" ? `${b}/${id}/${focus.archived_at ? "unarchive" : "archive"}${account ? `?back=${encodeURIComponent(ALL)}` : ""}` : undefined}
    archived={!!focus.archived_at}
  >
    {account && <span slot="folder" class="acct-chip" title="The account this conversation is in"><i style={`background: var(--acct-${account.color})`}></i>{address}</span>}
    {focus.direction === "in" && (
      <ThreadFolder slot="folder" view={folderView(focus, folders)} folders={folders} action={`${b}/${id}/folder?back=${encodeURIComponent(url.pathname)}`} threadHref={url.pathname} />
    )}
  </ThreadHeader>
  {ok && (
    <Banner tone="success">
      {ok}
      {undoFolder && (
        <form class="undo" method="post" action={`${b}/folders/${undoFolder.id}/undo?back=${encodeURIComponent(url.pathname)}`}><button type="submit">Undo</button></form>
      )}
    </Banner>
  )}
  {whyFolder && <WhyNot client:load base={b} messageId={focus.id} folderId={whyFolder.id} closeHref={url.pathname} />}
  {error && <Banner tone="error">{error}</Banner>}
  {warn && <Banner tone="warn" icon="alert">{warn}</Banner>}
  {bounced.map((e) => (
    <Banner tone="error">
      Your message to {e.message.recipient} {e.row.delivery_status === "bounced" ? "bounced" : "was not delivered"}
      {[e.row.delivery_code, (e.row as { delivery_detail?: string | null }).delivery_detail].filter(Boolean).length > 0 &&
        `: ${[e.row.delivery_code, (e.row as { delivery_detail?: string | null }).delivery_detail].filter(Boolean).join(" — ")}`}
    </Banner>
  ))}

  <div class="chat-log" data-live="chat">
    {entries.map((e, i) => {
      const prev = entries[i - 1];
      const day = formatDay(e.message.received_at);
      const newDay = !prev || formatDay(prev.message.received_at) !== day;
      const first = !prev || prev.envelope.from !== e.envelope.from || newDay || changes[i]!.length > 0;
      // HTML wins whenever there is any, as on the old page: most senders
      // (Gmail included) attach a plain-text copy that loses the formatting.
      const hasHtml = !!e.message.body_html;
      const text = hasHtml ? null : e.message.body_text;
      const split = text ? splitQuoted(text) : null;
      const bodyUrl = `${b}/${e.row.id}/body${showImages ? "?images=1" : ""}`;
      return (
        <Fragment>
          {newDay && <DayDivider label={day} />}
          <AudienceDivider actor={e.envelope.outbound ? "You" : displayName(e.envelope.from)} changes={changes[i]!} names={names} unverified={e.envelope.unverified} />
          <ChatMessage
            from={displayName(e.envelope.from)}
            address={e.envelope.from}
            time={formatTime(e.message.received_at)}
            outbound={e.envelope.outbound}
            first={first}
            tint={people.findIndex((p) => p.address === e.envelope.from) % 2 ? "secondary" : "primary"}
            status={deliveryStatus(e.row)}
            unverified={e.envelope.unverified}
            fromArchive={e.bodySource !== "hot"}
            htmlSrc={hasHtml ? bodyUrl : undefined}
            remoteImages={hasHtml && !showImages ? "?images=1" : undefined}
            actions={{
              reply: modeHref("reply", e.row.id),
              replyAll: modeHref("replyAll", e.row.id),
              forward: `${b}/compose?forward=${e.row.id}`,
            }}
          >
            {split ? split.fresh || split.quoted : hasHtml ? "" : "(no body)"}
            {split && split.fresh && split.quoted && <Fragment slot="quoted">{split.quoted}</Fragment>}
            {e.attachments.length > 0 && (
              <Fragment slot="attachments">
                {e.attachments.map((a) => (
                  <Attachment name={a.filename} size={formatSize(a.size)} href={`${b}/${e.row.id}/att/${encodeURIComponent(a.id)}`} />
                ))}
              </Fragment>
            )}
          </ChatMessage>
        </Fragment>
      );
    })}
  </div>

  <div id="reply">
    {readOnly ? (
      <p class="readonly"><span><b>{address} is disconnected.</b> You can read this, but replying needs Gmail.</span><a href={`/connect/google?account=${encodeURIComponent(address)}`}>Reconnect Gmail</a></p>
    ) : <ChatComposer
      action={`${b}/${target.row.id}/reply`}
      mode={mode}
      modeHrefs={{ reply: modeHref("reply"), replyAll: modeHref("replyAll"), forward: `${b}/compose?forward=${target.row.id}` }}
      to={replyTo}
      cc={replyCc}
      subject={replySubject}
      names={names}
      quote={quote}
      original={target.attachments.map((a) => ({ id: a.id, name: a.filename, size: formatSize(a.size) }))}
    />}
  </div>
  <ThreadInfo mailbox={address} threadId={threadId} size={formatSize(focusEntry.message.size)} source={focusEntry.bodySource === "hot" ? "local" : "archive"} />
</AppShell>

<style>
  .chat-log { padding-bottom: var(--space-2); }
  .undo { display: inline; margin-left: var(--space-2); }
  .undo button { font: 600 var(--text-sm) var(--font-sans); color: inherit; background: none; border: 0; padding: 0; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  .acct-chip { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); font-weight: 600; padding: 4px 10px; border-radius: var(--radius-pill); background: var(--surface-2); color: var(--text); white-space: nowrap; }
  .readonly { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: var(--space-4); padding: 12px 14px; border-radius: var(--radius-lg); background: var(--surface-2); font-size: var(--text-sm); color: var(--muted); }
  .readonly span { flex: 1; min-width: 24ch; }
  .readonly b { color: var(--text); font-weight: 600; }
  .readonly a { font-weight: 600; color: var(--primary); text-decoration: none; }
  .acct-chip i { width: 8px; height: 8px; border-radius: 50%; }
</style>
