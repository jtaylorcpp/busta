---
/**
 * GET /mb/<address> — a bin (Messages, Sent, Trash) or a folder
 * (?folder=<id>), with All/Unread and a "Starred first" sort. Row actions
 * post to the original handlers; folder decisions post to
 * /mb/<address>/<id>/folder.
 */
import { env } from "cloudflare:workers";
import AppShell from "../../../layouts/AppShell.astro";
import { Banner, Icon, ListFooter, MailList, MailRow } from "../../../components/ui";
import MailboxNav from "../../../components/app/MailboxNav.astro";
import AccountMenu from "../../../components/app/AccountMenu.astro";
import FolderChip from "../../../components/app/FolderChip.astro";
import FolderRowActions from "../../../components/app/FolderRowActions.astro";
import GettingStarted from "../../../components/app/GettingStarted.astro";
import { base, deliveryStatus, folderView, formatListDate, loadInbox, openMailbox } from "../../../lib/mail-data";

const { userId, orgId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/sign-in");
if (!orgId) return Astro.redirect("/");

const access = await openMailbox(env, { userId, orgId }, Astro.params.address!);
if (!access.ok) return new Response(access.message, { status: access.status });
const { address, stub } = access;
Astro.response.headers.set("cache-control", "no-store");

const url = Astro.url;
const data = await loadInbox(stub, url.searchParams);
// The Getting started guide lives on Messages itself, not in a folder or bin.
// Not for a connected account (Gmail): it arrives with your folders already.
const guide = !data.activeFolder && !data.label && data.view === "messages" && (await stub.sendingAs()) === "busta" ? await stub.guide() : null;
const b = base(address);
const ok = url.searchParams.get("ok");
const error = url.searchParams.get("error");
const warn = url.searchParams.get("warn");

/** Link to this same view with some params changed (null removes one). */
const withParams = (changes: Record<string, string | null>) => {
  const q = new URLSearchParams(url.searchParams);
  for (const k of ["ok", "error", "warn", "before"]) q.delete(k);
  for (const [k, v] of Object.entries(changes)) (v === null ? q.delete(k) : q.set(k, v));
  const s = q.toString();
  return `${b}${s ? `?${s}` : ""}`;
};
const heading = data.activeFolder?.name ?? (data.label ? `+${data.label}` : data.view === "trash" ? "Trash" : data.view === "sent" ? "Sent" : data.view === "archive" ? "Archive" : "Messages");
const bin = data.view === "messages" ? "messages" : data.view;
const unreadCount = data.activeFolder ? data.activeFolder.unread : data.view === "messages" ? data.messages.filter((m) => !m.read).length : 0;
const [local, domain] = address.split("@");
const back = url.pathname + url.search;
// "Archived … Undo": the row action came back with ?archived=<address>:<id>.
const archivedRaw = url.searchParams.get("archived");
const archivedParam = archivedRaw && archivedRaw.includes(":") ? { address: archivedRaw.slice(0, archivedRaw.lastIndexOf(":")), id: archivedRaw.slice(archivedRaw.lastIndexOf(":") + 1) } : null;
const undoBack = (() => { const q = new URLSearchParams(url.search); for (const k of ["ok", "error", "archived"]) q.delete(k); const s = q.toString(); return url.pathname + (s ? `?${s}` : ""); })();

---
<AppShell title={`${heading} — ${address}`} mailbox={address} composeHref={`${b}/compose`} searchAction={`${b}/search`}>
  <AccountMenu slot="account" current={address} />
  <MailboxNav slot="nav" address={address} bin={bin} folderId={data.activeFolder?.id ?? null} />

  {ok && !archivedParam && <Banner tone="success">{ok}</Banner>}
  {archivedParam && (
    <Banner tone="success">
      {ok ?? "Archived."}
      <form method="post" action={`/mb/${encodeURIComponent(archivedParam.address)}/${archivedParam.id}/unarchive?back=${encodeURIComponent(undoBack)}`} class="undo"><button type="submit">Undo</button></form>
    </Banner>
  )}

  {error && <Banner tone="error">{error}</Banner>}
  {warn && <Banner tone="warn" icon="alert">{warn}</Banner>}
  {data.agent.enabled && (
    <Banner tone="agent"><b>Agent on</b> · acting on {data.agent.labels.length ? data.agent.labels.map((l) => `+${l}`).join(", ") : "all mail"} · {data.agent.autoSend ? "auto-send" : "drafts held for review"}</Banner>
  )}

  <header class="head">
    <div class="title">
      <h1>{heading}</h1>
      {data.activeFolder && (
        <a class="edit" href={`${b}/folders/${data.activeFolder.id}`}><Icon name="pen" size={13} />Edit rule</a>
      )}
    </div>
    {data.view !== "trash" && (
      <nav class="filters" aria-label="Filter and sort">
        <a class:list={["chip", { on: !data.unread }]} href={withParams({ unread: null })} aria-current={!data.unread ? "true" : undefined}>All</a>
        <a class:list={["chip", { on: data.unread }]} href={withParams({ unread: "1" })} aria-current={data.unread ? "true" : undefined}>Unread{unreadCount > 0 && !data.unread ? ` · ${unreadCount}` : ""}</a>
        <span class="sep" aria-hidden="true"></span>
        <a class:list={["chip", "sort", { on: data.starredFirst }]} href={withParams({ sort: data.starredFirst ? null : "starred", view: data.view === "messages" ? null : data.view })} aria-pressed={data.starredFirst ? "true" : "false"} title="Pin starred mail to the top">
          <Icon name="star" size={13} filled={data.starredFirst} />Starred first
        </a>
      </nav>
    )}
  </header>

  {guide && <GettingStarted address={address} guide={guide} folders={data.folders} />}

  <div data-live="list">
  <MailList empty={data.messages.length === 0}>
    {data.messages.map((m, i) => {
      const status = deliveryStatus(m);
      const to = `${b}/${m.id}`;
      const fv = folderView(m, data.folders);
      const showChip = m.direction === "in" && !(data.activeFolder && fv.folderId === data.activeFolder.id && fv.source === "rule");
      return (
        <Fragment>
          {data.starredFirst && i === data.pinnedCount && data.pinnedCount > 0 && <li class="divider" aria-hidden="true"></li>}
          <MailRow
            href={to}
            from={m.direction === "out" ? m.recipient : m.from_name ? `${m.from_name}` : m.sender}
            subject={m.subject || "(no subject)"}
            snippet={m.snippet}
            date={formatListDate(m.received_at)}
            unread={!m.read}
            starred={!!m.starred}
            outbound={m.direction === "out"}
            status={status && status.label !== "Sent" ? status : undefined}
            attachments={m.attachment_count}
            unverified={m.grafted === 1}
            starAction={data.view === "trash" ? undefined : `${to}/${m.starred ? "unstar" : "star"}`}
            trashAction={data.view === "trash" ? undefined : `${to}/trash`}
            archiveAction={data.view === "messages" && m.direction === "in" ? `${to}/archive?back=${encodeURIComponent(back)}` : undefined}
            unarchiveAction={data.view === "archive" ? `${to}/unarchive?back=${encodeURIComponent(back)}` : undefined}
            restoreAction={data.view === "trash" ? `${to}/restore` : undefined}
            purgeAction={data.view === "trash" ? `${to}/purge` : undefined}
          >
            {showChip && <FolderChip slot="chip" view={fv} />}
            {m.direction === "in" && (fv.state === "unsure" || fv.state === "failed") && (
              <FolderRowActions slot="actions" view={fv} href={to} action={`${to}/folder?back=${encodeURIComponent(back)}`} retry={`${to}/folder/retry?back=${encodeURIComponent(back)}`} />
            )}
          </MailRow>
        </Fragment>
      );
    })}
    <Fragment slot="empty">
      {data.activeFolder
        ? `Nothing in ${data.activeFolder.name} yet.`
        : data.unread
          ? "No unread messages."
          : data.view === "trash" ? "Trash is empty." : data.view === "sent" ? "Nothing sent yet." : data.view === "archive" ? "Nothing archived. Archive keeps mail you're done with out of Messages." : "No messages yet."}
    </Fragment>
  </MailList>

  <ListFooter
    from={data.messages.length ? 1 : 0}
    to={data.messages.length}
    total={data.messages.length}
    mailbox={address}
    nextHref={data.nextBefore !== null ? withParams({ before: String(data.nextBefore) }) : undefined}
  />
  </div>
  {!data.activeFolder && data.view === "messages" && (
    <p class="hint">Hand out <code>{local}+anything@{domain}</code>. A folder can catch mail sent to its own +address.</p>
  )}
</AppShell>

<style>
  .head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); padding: 14px var(--space-4) 10px; border-bottom: 1px solid var(--border); }
  .title { display: flex; align-items: baseline; gap: var(--space-3); }
  h1 { font-size: var(--text-xl); font-weight: 600; }
  .edit { display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-sm); color: var(--muted); text-decoration: none; }
  .edit:hover { color: var(--primary); }
  .filters { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .chip {
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 500; color: var(--muted); text-decoration: none; border: 1px solid var(--border);
  }
  .chip:hover { color: var(--text); background: var(--surface-2); }
  .chip.on { background: var(--primary-soft); color: var(--primary); border-color: transparent; }
  .sort.on { --icon-fill: var(--star); }
  .sep { width: 1px; height: 18px; background: var(--border); margin: 0 4px; }
  .divider { list-style: none; height: 0; border-top: 2px solid var(--border); }
  .hint { padding: 0 var(--space-4) var(--space-4); font-size: var(--text-xs); color: var(--muted); }
  code { font-family: var(--font-mono); }
  .undo { display: inline; margin-left: 8px; }
  .undo button { font: 600 inherit var(--font-sans); font-size: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
</style>
