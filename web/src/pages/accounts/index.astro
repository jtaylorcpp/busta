---
/**
 * GET /accounts — your accounts, their colors, and each Gmail connection:
 * status, what stays in step, Reconnect, Disconnect
 * (designs/2026-09-24-connect-gmail, screen 8).
 */
import { env } from "cloudflare:workers";
import FolderPageShell from "../../components/app/FolderPageShell.astro";
import { Button, Icon } from "../../components/ui";
import { ACCOUNT_COLORS, ALL, listAccounts, openShown } from "../../lib/accounts";
import { formatListDate } from "../../lib/mail-data";
import { importStub } from "../../../../src/mail";

const { userId, orgId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/sign-in");
if (!orgId) return Astro.redirect("/");
Astro.response.headers.set("cache-control", "no-store");

const accounts = await listAccounts(env, orgId);
if (accounts.length === 0) return Astro.redirect("/");
const opened = await openShown(env, { userId, orgId }, accounts.map((a) => ({ ...a, shown: true })));
const rows = await Promise.all(opened.map(async (a) => ({
  ...a,
  shownNow: accounts.find((x) => x.address === a.address)!.shown,
  gmail: a.kind === "gmail" ? await a.stub.gmailStatus() : null,
  queue: a.kind === "gmail" ? await importStub(env, a.address).status() : null,
  purge: a.kind === "gmail" ? await a.stub.purgeStatus() : null,
})));
const home = accounts[0]!.address;
const back = accounts.length > 1 ? ALL : `/mb/${encodeURIComponent(home)}`;
const when = (ms: number | null | undefined) => (ms ? formatListDate(ms) : "not yet");
---
<FolderPageShell title="Accounts" address={home} backHref={back} backLabel="Back to your mail" bin={null} current={accounts.length > 1 ? null : home}>
  <Fragment slot="actions"><Button href="/connect/gmail" size="sm"><Icon name="mail" size={14} />Connect Gmail</Button></Fragment>
  <div class="set">
    {rows.map((a) => (
      <section class="panel" style={`--acct: var(--acct-${a.color})`}>
        <div class="ph">
          <span class="av">{a.address.charAt(0).toUpperCase()}</span>
          <span class="who"><b>{a.address}</b><small>{a.kind === "gmail" ? "Gmail" : "Busta address"} · {a.shownNow ? "shown in all mail" : "hidden from all mail"}</small></span>
          <form method="post" action="/accounts/color" class="swatches" aria-label={`Color for ${a.address}`}>
            <input type="hidden" name="address" value={a.address} />
            {ACCOUNT_COLORS.map((c) => (
              <button type="submit" name="color" value={c} class:list={["sw", { sel: c === a.color }]} style={`background: var(--acct-${c})`} aria-label={c} aria-pressed={c === a.color ? "true" : "false"} title={c}></button>
            ))}
          </form>
        </div>

        {a.purge && (
          <div class="discon"><span class="live wait"><i></i>Deleting from Busta · {a.purge.done} of {a.purge.total}</span><p class="hint">Your Gmail isn't touched. This account leaves the list when it's done.</p></div>
        )}
        {a.gmail && !a.purge && (
          <Fragment>
            {a.gmail.status === "needs_reconnect" && (
              <div class="err">
                <Icon name="alert" size={15} />
                <span><b>Gmail stopped syncing.</b> {a.gmail.lastError ?? "Google no longer accepts Busta's access."} Mail since then is still in Gmail.</span>
                <Button variant="danger" size="sm" href={`/connect/google?account=${encodeURIComponent(a.address)}`}>Reconnect Gmail</Button>
              </div>
            )}
            <dl class="kv">
              <dt>Status</dt>
              <dd>
                {a.gmail.status === "live" && <span class="live"><i></i>Connected · checked {when(a.gmail.lastSyncAt)}</span>}
                {a.gmail.status === "needs_reconnect" && <span class="live bad"><i></i>Needs you</span>}
              </dd>
              <dt>Busta can</dt><dd>Read, organize and send. Can't permanently delete.</dd>
              <dt>New mail</dt><dd>Arrives within seconds · last brought in {when(a.gmail.lastMailAt)}</dd>
              <dt>Brought in</dt>
              <dd>
                {!a.queue && "Nothing yet"}
                {a.queue && (a.queue.phase === "done"
                  ? <Fragment>{a.queue.done} messages{a.queue.coveredAfter ? ` back to ${formatListDate(a.queue.coveredAfter * 1000)}` : ", everything"}</Fragment>
                  : <span class="live wait"><i></i>{a.queue.phase === "paused" ? "Paused until Gmail is reconnected" : `Bringing in · ${a.queue.done} of about ${a.queue.total || "…"}`}</span>)}
                {a.queue?.lastError && a.queue.phase !== "done" && <span class="muted"> · last problem: {a.queue.lastError} (retrying)</span>}
              </dd>
              <dt>Stays in step</dt><dd>Read, star, archive and trash, both ways{a.gmail.changesWaiting ? ` · ${a.gmail.changesWaiting} change${a.gmail.changesWaiting > 1 ? "s" : ""} waiting to reach Gmail` : ""}. Folders stay in Busta.</dd>
              <dt>Stays connected</dt><dd>Busta renews Gmail's alerts every day{a.gmail.watchExpires ? `; the current one lasts until ${formatListDate(a.gmail.watchExpires)}` : ""}.</dd>
              {a.gmail.lastError && a.gmail.status !== "needs_reconnect" && (<Fragment><dt>Last problem</dt><dd class="muted">{a.gmail.lastError}</dd></Fragment>)}
            </dl>
            {a.gmail.status === "live" && (!a.queue || a.queue.phase === "done") && (a.queue?.coveredAfter ?? 1) !== 0 && (
              <form class="discon" method="post" action="/accounts/import">
                <input type="hidden" name="address" value={a.address} />
                <b class="lbl">Bring in older mail</b>
                <div class="opts">
                  {[[90, "90 days"], [365, "1 year"], [0, "Everything"]].map(([v, l]) => (
                    <label class="opt"><input type="radio" name="days" value={v} checked={v === 365} />{l}</label>
                  ))}
                  <Button size="sm" type="submit">Bring in</Button>
                </div>
                <p class="hint">Newest first; it slots in by date. The newest 1,000 are sorted by your rules, the rest come in unsorted.</p>
              </form>
            )}
            <div class="discon">
              <p class="hint">Stop syncing and remove Busta's access at Google. You choose what happens to the mail already in Busta.</p>
              <div><Button variant="danger" size="sm" href={`/accounts/disconnect?address=${encodeURIComponent(a.address)}`}>Disconnect Gmail…</Button></div>
            </div>
          </Fragment>
        )}
        {!a.gmail && !a.purge && a.kind === "gmail" && (
          <div class="discon">
            <p class="hint">Disconnected. The mail brought in earlier stays here, read-only.</p>
            <div class="row-btns">
              <Button size="sm" href={`/connect/google?account=${encodeURIComponent(a.address)}`}>Reconnect Gmail</Button>
              <Button variant="danger" size="sm" href={`/accounts/disconnect?address=${encodeURIComponent(a.address)}`}>Delete from Busta…</Button>
            </div>
          </div>
        )}
      </section>
    ))}
  </div>
</FolderPageShell>

<style>
  .set { display: grid; gap: var(--space-4); padding: var(--space-5); max-width: 820px; }
  .panel { border: 1px solid var(--border); border-left: 3px solid var(--acct); border-radius: var(--radius-lg); overflow: hidden; }
  .ph { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: var(--surface-2); flex-wrap: wrap; }
  .av { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; color: var(--acct); background: var(--surface); border: 2px solid var(--acct); }
  .who { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .who b { font-weight: 600; overflow-wrap: anywhere; }
  .who small, .muted { font-size: var(--text-xs); color: var(--muted); }
  .swatches { display: flex; gap: 6px; }
  .sw { width: 20px; height: 20px; border-radius: 50%; border: 0; cursor: pointer; padding: 0; }
  .sw.sel { box-shadow: 0 0 0 2px var(--surface-2), 0 0 0 4px var(--text); }
  .sw:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .kv { display: grid; grid-template-columns: 150px 1fr; margin: 0; }
  .kv dt, .kv dd { margin: 0; padding: 9px 14px; border-top: 1px solid var(--border); font-size: var(--text-sm); }
  .kv dt { color: var(--muted); }
  @media (max-width: 640px) { .kv { grid-template-columns: 1fr; } .kv dd { border-top: 0; padding-top: 0; } }
  .live { display: inline-flex; align-items: center; gap: 6px; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--success); }
  .live.wait i { background: var(--warn-fill); }
  .live.bad i { background: var(--error); }
  .err { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 10px 14px; background: var(--error-soft); color: var(--error); font-size: var(--text-sm); border-top: 1px solid var(--border); }
  .err span { flex: 1; min-width: 24ch; }
  .err b { font-weight: 600; }
  .discon { display: grid; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--border); }
  .hint { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .lbl { font-size: var(--text-sm); font-weight: 600; }
  .opts { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .opt { display: inline-flex; align-items: center; font: 600 var(--text-sm) var(--font-sans); padding: 5px 12px; border-radius: var(--radius-pill); border: 1px solid var(--border); color: var(--muted); cursor: pointer; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt:has(input:checked) { background: var(--primary-soft); border-color: transparent; color: var(--primary); }
  .opt:has(input:focus-visible) { outline: 2px solid var(--primary); outline-offset: 1px; }
  .row-btns { display: flex; gap: 8px; flex-wrap: wrap; }
</style>
