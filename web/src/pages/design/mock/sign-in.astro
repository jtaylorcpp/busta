---
/**
 * Sign-in screen from the design. In the real app Clerk's <SignIn /> fills
 * the card, styled by lib/clerk-appearance.ts; this stand-in uses our own
 * components so the layout can be reviewed without Clerk keys.
 */
import AuthLayout from "../../../layouts/AuthLayout.astro";
import { Button, Field } from "../../../components/ui";
---
<AuthLayout title="Sign in" heading="Sign in to Busta" subheading="Your team's mail, on your own domain.">
  <div class="card">
    <p class="stand-in">Stand-in for Clerk <code>&lt;SignIn /&gt;</code></p>
    <Button size="lg" class="wide"><span class="g" aria-hidden="true">G</span>Continue with Google</Button>
    <div class="or"><span>or</span></div>
    <form class="form" method="post" action="#">
      <Field id="email" name="email" type="email" label="Email address" placeholder="you@busta.app" autocomplete="email" />
      <Button variant="primary" size="lg" type="submit" class="wide">Continue</Button>
    </form>
    <p class="alt">No account yet? <a href="#">Sign up</a></p>
    <p class="foot">Secured by Clerk</p>
  </div>
  <p class="legal">busta.app · <a href="#">Privacy</a> · <a href="#">Terms</a></p>
</AuthLayout>

<style>
  .card {
    width: min(100%, 400px); display: grid; gap: var(--space-4); text-align: left;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2); padding: var(--space-5);
  }
  .stand-in { font: var(--text-xs)/1 var(--font-mono); color: var(--faint); text-align: center; }
  .card :global(.wide) { width: 100%; }
  .g { font-weight: 700; color: var(--primary); }
  .or { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  .or::before, .or::after { content: ""; height: 1px; background: var(--border); }
  .form { display: grid; gap: var(--space-4); }
  .alt { text-align: center; font-size: var(--text-sm); color: var(--muted); }
  .foot { text-align: center; font-size: var(--text-xs); color: var(--faint); border-top: 1px solid var(--border); padding-top: var(--space-3); }
  .legal { font-size: var(--text-xs); color: var(--muted); margin-top: var(--space-4); }
  .legal a { color: var(--muted); }
</style>
