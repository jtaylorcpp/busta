---
/**
 * The folder control in a thread's header. Shows how the message was filed
 * (rule + match %, +address, or by you) and opens a small panel with the
 * model's top probabilities, "Move to…" every folder, and "Not this folder".
 * Anything chosen here is a manual choice that rules never override.
 */
import { Icon } from "../ui";
import type { FolderView } from "../../lib/mail-data";

interface Props {
  view: FolderView;
  folders: { id: string; name: string }[];
  /** POST target: /mb/<addr>/<id>/folder (field `folder`, "" for none). */
  action: string;
}
const { view: v, folders, action } = Astro.props;
const pct = (n: number | null | undefined) => (typeof n === "number" ? `${Math.round(n * 100)}%` : "");
const nameOf = (id: string) => (id === "none" ? "No folder" : folders.find((f) => f.id === id)?.name ?? "Deleted folder");
const summary =
  v.state === "filed" && v.name
    ? v.source === "you" ? `${v.name} · filed by you` : v.source === "address" ? `${v.name} · +${v.label}` : `Filed by rule · ${v.name} · ${pct(v.confidence)}`
    : v.state === "unsure" && v.suggestName ? `Unsure: ${v.suggestName} ${pct(v.confidence)}`
    : v.state === "pending" ? "Sorting…"
    : v.state === "failed" ? "Couldn't sort"
    : v.source === "you" ? "No folder · by you"
    : "No folder";
const probs = v.probs ? Object.entries(v.probs).sort((a, b) => b[1] - a[1]) : [];
---
<details class="tf" data-thread-folder data-live="thread-folder">
  <summary class:list={[v.state === "filed" ? "filed" : v.state === "pending" ? "sorting" : "plain"]}>
    {v.source === "you" && <Icon name="lock" size={11} />}
    {summary}
    <Icon name="more" size={13} />
  </summary>
  <div class="panel">
    {probs.length > 0 && v.source === "rule" && (
      <section>
        <h4>How the rule scored it</h4>
        <ul class="bars">
          {probs.map(([id, p]) => (
            <li><span class="n">{nameOf(id)}</span><span class="bar"><i style={`width:${Math.round(p * 100)}%`}></i></span><span class="p">{pct(p)}</span></li>
          ))}
        </ul>
      </section>
    )}
    <section>
      <h4>Move to</h4>
      <ul class="moves">
        {folders.map((f) => (
          <li>
            <form method="post" action={action}>
              <input type="hidden" name="folder" value={f.id} />
              <button type="submit" aria-current={v.folderId === f.id ? "true" : undefined}>
                <span class="check">{v.folderId === f.id && <Icon name="check" size={13} />}</span>{f.name}
              </button>
            </form>
          </li>
        ))}
        {folders.length === 0 && <li class="none">No folders yet.</li>}
      </ul>
    </section>
    {v.folderId && (
      <section>
        <form method="post" action={action}>
          <input type="hidden" name="folder" value="" />
          <button type="submit" class="not">Not this folder</button>
        </form>
        <p class="note">Sends it back to Messages. Rules won't refile it.</p>
      </section>
    )}
  </div>
</details>

<script>
  // Delegated, because live updates replace this element.
  const openMenus = () => document.querySelectorAll<HTMLDetailsElement>("[data-thread-folder][open]");
  document.addEventListener("click", (e) => {
    for (const m of openMenus()) if (!m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") for (const m of openMenus()) m.open = false;
  });
</script>

<style>
  .tf { position: relative; }
  summary {
    list-style: none; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    font-size: var(--text-xs); font-weight: 500; padding: 4px 8px; border-radius: var(--radius-sm);
  }
  summary::-webkit-details-marker { display: none; }
  .filed { background: var(--secondary-soft); color: var(--secondary); }
  .sorting { background: var(--warn-soft); color: var(--warn); }
  .plain { border: 1px dashed var(--border); color: var(--muted); }
  summary:hover { filter: brightness(.97); }
  .panel {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 25; width: 280px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-2);
  }
  section { padding: 10px 12px; border-bottom: 1px solid var(--border); display: grid; gap: 6px; }
  section:last-child { border-bottom: 0; }
  h4 { margin: 0; font: 500 var(--text-xs)/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .bars, .moves { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .bars li { display: grid; grid-template-columns: 90px 1fr 36px; gap: 8px; align-items: center; font-size: var(--text-xs); color: var(--secondary); }
  .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar { height: 6px; border-radius: 3px; background: var(--surface-2); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--secondary); opacity: .6; }
  .p { text-align: right; font-variant-numeric: tabular-nums; }
  .moves form, section > form { display: block; }
  .moves button, .not {
    width: 100%; display: flex; align-items: center; gap: 6px; text-align: left; cursor: pointer;
    font: 500 var(--text-sm) var(--font-sans); padding: 6px 8px; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text);
  }
  .moves button:hover, .not:hover { background: var(--surface-2); }
  .moves button[aria-current] { color: var(--primary); }
  .check { width: 14px; display: inline-grid; }
  .not { color: var(--secondary); }
  .none { font-size: var(--text-sm); color: var(--muted); padding: 4px 8px; }
  .note { margin: 0; font-size: var(--text-xs); color: var(--muted); padding: 0 8px; }
</style>
