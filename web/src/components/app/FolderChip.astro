---
/**
 * A row's folder state, as a chip inside the row link:
 *   filed by a rule   slate chip + "auto"      filed by you   outlined + lock
 *   +address match    mono "+label"            sorting        amber "Sorting…"
 *   unsure            muted "Unsure: Bank 48%" couldn't sort  muted "Couldn't sort"
 * "none" (no folder fits) shows nothing. Actions for unsure/failed live in
 * FolderRowActions, outside the link.
 */
import Icon from "../ui/Icon.astro";
import type { FolderView } from "../../lib/mail-data";

interface Props { view: FolderView }
const { view: v } = Astro.props;
const pct = (n: number | null) => (n === null || n === undefined ? "" : `${Math.round(n * 100)}%`);
---
{v.state === "pending" && <span class="fc sorting"><i class="spin" aria-hidden="true"></i>Sorting…</span>}
{v.state === "failed" && <span class="fc muted">Couldn't sort</span>}
{v.state === "unsure" && v.suggestName && <span class="fc muted" title="Below the confidence threshold, so it stayed in Messages">Unsure: {v.suggestName} {pct(v.confidence)}</span>}
{v.state === "filed" && v.name && (
  v.source === "you" ? (
    <span class="fc you" title="Filed by you. Rules won't change it."><Icon name="lock" size={11} />{v.name}</span>
  ) : v.source === "address" ? (
    <span class="fc addr" title={`Sent to +${v.label}`}>+{v.label}</span>
  ) : (
    <span class="fc rule" title={`Filed by rule · ${pct(v.confidence)} match`}>{v.name}<b>auto</b></span>
  )
)}
{v.state === "none" && v.source === "you" && <span class="fc you" title="You chose no folder. Rules won't change it."><Icon name="lock" size={11} />No folder</span>}

<style>
  .fc {
    display: inline-flex; align-items: center; gap: 5px; margin-right: 6px; vertical-align: 1px;
    font-size: var(--text-xs); font-weight: 500; line-height: 1; padding: 4px 8px; border-radius: var(--radius-sm); white-space: nowrap;
  }
  .rule { background: var(--secondary-soft); color: var(--secondary); }
  .rule b { font: 600 9.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; opacity: .7; }
  .you { border: 1px solid var(--border); color: var(--secondary); }
  .addr { font-family: var(--font-mono); background: var(--secondary-soft); color: var(--secondary); }
  .sorting { background: var(--warn-soft); color: var(--warn); }
  .muted { color: var(--muted); border: 1px dashed var(--border); }
  .spin { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid currentColor; border-top-color: transparent; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
