---
/**
 * The compose form, shared by new mail, forwarding and editing a draft. It
 * posts to the original handler (POST /mb/<addr>/compose), which sends or,
 * with action=save, saves a draft — so its field names are fixed: to, cc,
 * bcc, subject, body, files, reattach, forwardFrom, draftId, threadId.
 */
import { Attachment, Button, Icon } from "../ui";
import RecipientInput from "../islands/RecipientInput";
import AttachmentPicker from "../islands/AttachmentPicker";
import { formatSize } from "../../lib/mail-data";

interface File { id: string; filename: string; size: number }
interface Props {
  base: string;
  prefill?: { to?: string; cc?: string; bcc?: string; subject?: string; body?: string };
  /** Addresses in the prefill already known to have bounced. */
  bounced?: string[];
  forward?: { messageId: string; attachments: File[] };
  draft?: { id: string; threadId: string | null; attachments: File[]; savedAt: string };
  limits: { inline: string; inlineBytes: number; linkDays: number };
  /**
   * With 2+ accounts, a new message can pick its From. Choosing another
   * account points the form at that account's compose, so it sends (and
   * saves drafts) there. The choice is remembered as "last used".
   */
  from?: { current: string; options: { address: string; color: string; via: string }[] };
}
const { base, prefill = {}, bounced = [], forward, draft, limits, from } = Astro.props;
const check = `${base}/recipients/check`;
---
<form class="compose" method="post" action={`${base}/compose`} enctype="multipart/form-data" data-compose>
  <div class="rows">
    {from && (
      <div class="rcpt from-row">
        <label for="from">From</label>
        <span class="from-dot" aria-hidden="true" style={`background: var(--acct-${from.options.find((o) => o.address === from.current)?.color ?? "blue"})`}></span>
        <select id="from" data-from>
          {from.options.map((o) => <option value={o.address} data-color={o.color} data-via={o.via} selected={o.address === from.current}>{o.address} · {o.via}</option>)}
        </select>
      </div>
    )}
    <RecipientInput client:load id="to" name="to" label="To" value={prefill.to} bounced={bounced} checkUrl={check} placeholder="someone@example.com" autofocus={!prefill.to} />
    <RecipientInput client:load id="cc" name="cc" label="Cc" value={prefill.cc} bounced={bounced} checkUrl={check} />
    <RecipientInput client:load id="bcc" name="bcc" label="Bcc" value={prefill.bcc} bounced={bounced} checkUrl={check} hint="Hidden from other recipients." />
    <div class="rcpt">
      <label for="subject">Subject</label>
      <input id="subject" name="subject" type="text" value={prefill.subject ?? ""} />
    </div>
  </div>

  <label class="visually-hidden" for="body">Message</label>
  <textarea id="body" name="body" rows="14" placeholder="Write your message…" autofocus={!!prefill.to && !prefill.body}>{prefill.body ?? ""}</textarea>

  {forward && forward.attachments.length > 0 && (
    <fieldset class="carry">
      <legend>Forward these attachments</legend>
      {forward.attachments.map((a) => (
        <label class="pick">
          <input type="checkbox" name="reattach" value={a.id} checked />
          <Icon name="check" size={13} class="tick" />
          <span>{a.filename}</span><span class="sz">· {formatSize(a.size)}</span>
        </label>
      ))}
    </fieldset>
  )}
  {forward && <input type="hidden" name="forwardFrom" value={forward.messageId} />}

  {draft && (
    <Fragment>
      <input type="hidden" name="draftId" value={draft.id} />
      <input type="hidden" name="threadId" value={draft.threadId ?? ""} />
      {draft.attachments.length > 0 && (
        <div class="carry saved">
          <span class="legend">Saved with this draft</span>
          {draft.attachments.map((a) => <Attachment name={a.filename} size={formatSize(a.size)} />)}
        </div>
      )}
    </Fragment>
  )}

  <AttachmentPicker client:visible inlineBytes={limits.inlineBytes} linkDays={limits.linkDays} />
  <p class="hint">Files up to {limits.inline} ride along with the message. Larger files are stored and sent as a download link that expires in {limits.linkDays} days.</p>

  <div class="actions">
    <Button variant="primary" type="submit" name="action" value="send"><Icon name="send" size={15} />Send</Button>
    <Button type="submit" name="action" value="save" formnovalidate>Save draft</Button>
    {draft ? (
      <Button variant="ghost" type="submit" formaction={`${base}/drafts/${draft.id}/delete`} formnovalidate>Discard</Button>
    ) : (
      <Button variant="ghost" href={base}>Discard</Button>
    )}
    {draft && <span class="saved-at">Last saved {draft.savedAt}</span>}
  </div>
</form>

<script>
  // From: point the form at the chosen account's compose; remember it as last used.
  for (const el of Array.from(document.querySelectorAll("[data-from]"))) {
    const sel = el as unknown as { value: string; selectedOptions: HTMLCollectionOf<HTMLOptionElement>; closest: Element["closest"]; addEventListener: Element["addEventListener"] };
    const form = sel.closest<HTMLFormElement>("[data-compose]");
    const dot = form?.querySelector<HTMLElement>(".from-dot");
    sel.addEventListener("change", () => {
      if (!form) return;
      form.action = `/mb/${encodeURIComponent(sel.value)}/compose`;
      const color = sel.selectedOptions[0]?.dataset.color;
      if (dot && color) dot.style.background = `var(--acct-${color})`;
    });
    form?.addEventListener("submit", () => { document.cookie = `busta_from=${encodeURIComponent(sel.value)}; path=/; max-age=31536000; samesite=lax`; });
  }
</script>

<style>
  .compose { display: grid; gap: var(--space-4); padding: var(--space-4) var(--space-5) var(--space-5); }
  .rows { display: grid; }
  .compose :global(.rcpt) { display: grid; grid-template-columns: 64px 1fr; align-items: start; column-gap: var(--space-3); padding: 6px 0; border-bottom: 1px solid var(--border); }
  .compose :global(.rcpt > label) { font-size: var(--text-sm); color: var(--muted); padding-top: 9px; }
  .compose :global(.rcpt > input), .compose :global(.rcpt .box) {
    width: 100%; min-height: 38px; border: 0; background: transparent; color: var(--text); font-size: var(--text-md); padding: 8px 0;
  }
  .compose :global(.rcpt > input:focus) { outline: none; }
  .compose :global(.rcpt .box) { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 5px 0; cursor: text; }
  .compose :global(.rcpt .box input) { flex: 1; min-width: 140px; border: 0; background: transparent; color: var(--text); font-size: var(--text-md); padding: 3px 0; outline: none; }
  .compose :global(.rcpt .note) { grid-column: 2; font-size: var(--text-xs); color: var(--muted); padding-bottom: 4px; }
  .compose :global(.rcpt .note.bounce) { color: var(--error); }
  .compose :global(.chip) {
    display: inline-flex; align-items: center; gap: 4px; padding: 3px 4px 3px 10px; border-radius: var(--radius-pill);
    background: var(--secondary-soft); color: var(--text); font-size: var(--text-sm);
  }
  .compose :global(.chip.bounced) { background: var(--error-soft); color: var(--error); box-shadow: inset 0 0 0 1px var(--error); }
  .compose :global(.chip.invalid) { box-shadow: inset 0 0 0 1px var(--warn); }
  .compose :global(.chip button), .compose :global(.file button) {
    width: 20px; height: 20px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; font-size: 15px; line-height: 1;
  }
  .compose :global(.chip button:hover), .compose :global(.file button:hover) { background: var(--surface-2); }
  #subject { font-weight: 600; }
  textarea {
    width: 100%; min-height: 260px; resize: vertical; padding: 12px 14px; border-radius: var(--radius-md);
    border: 1.5px solid var(--border); background: var(--bg); color: var(--text); font: var(--text-md)/1.6 var(--font-sans);
  }
  textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); background: var(--surface); }

  .carry { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .carry legend, .carry .legend { float: left; font-size: var(--text-sm); color: var(--muted); font-weight: 500; margin-right: var(--space-2); padding: 0; }
  .pick {
    position: relative; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    padding: 5px 11px 5px 9px; border-radius: var(--radius-pill); font-size: var(--text-sm);
    background: var(--surface); border: 1px solid var(--border); color: var(--secondary);
  }
  .pick input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pick :global(.tick) { display: none; }
  .pick:has(input:checked) { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); }
  .pick:has(input:checked) :global(.tick) { display: inline; }
  .pick:has(input:focus-visible) { outline: 2px solid var(--primary); outline-offset: 2px; }
  .sz { opacity: .75; font-variant-numeric: tabular-nums; }

  .compose :global(.picker) { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .compose :global(.attach) { display: inline-flex; }
  .compose :global(.attach .lbl) {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer; padding: 7px 12px; border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 600; color: var(--muted);
  }
  .compose :global(.attach .lbl:hover) { background: var(--surface-2); color: var(--text); }
  .compose :global(.attach:focus-within .lbl) { outline: 2px solid var(--primary); outline-offset: 2px; }
  .compose :global(.file) {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 4px 4px 11px; border-radius: var(--radius-pill);
    border: 1px solid var(--border); background: var(--surface); font-size: var(--text-sm); max-width: 100%;
  }
  .compose :global(.file .fn) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px; }
  .compose :global(.file .sz) { color: var(--muted); }
  .compose :global(.link-badge) { font-size: var(--text-xs); font-weight: 600; padding: 2px 7px; border-radius: var(--radius-pill); background: var(--warn-soft); color: var(--warn); }
  .hint { font-size: var(--text-xs); color: var(--muted); margin-top: calc(var(--space-2) * -1); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .saved-at { margin-left: auto; font-size: var(--text-xs); color: var(--muted); }
  @media (max-width: 640px) { .compose { padding: var(--space-3); } .compose :global(.rcpt) { grid-template-columns: 44px 1fr; } }
  .from-row { display: flex; align-items: center; gap: 8px; }
  .from-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .from-row select { flex: 1; min-width: 0; font: inherit; color: var(--text); background: transparent; border: 0; padding: 8px 0; cursor: pointer; }
</style>
