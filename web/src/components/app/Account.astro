---
import { UserButton } from "@clerk/astro/components";
/** Signed-in account control for the top bar: Clerk's menu plus a plain sign-out link that works without JavaScript. */
---
<span class="account">
  <UserButton />
  <a class="out" href="/sign-out">Sign out</a>
</span>

<style>
  .account { display: inline-flex; align-items: center; gap: var(--space-3); }
  .out { font-size: var(--text-sm); color: var(--muted); text-decoration: none; }
  .out:hover { color: var(--text); text-decoration: underline; }
</style>
