---
/**
 * The Getting started guide on Messages (designs/2026-09-24-getting-started).
 * Three steps: describe what matters (/start → the "Must read" folder), send
 * yourself a test (/start/test), see where it went (here, once it lands).
 * After Finish it shrinks to a one-time "You're set up" bar.
 *
 * Always renders its data-live="guide" wrapper so live updates can swap it:
 * the test message arriving, then "Sorting…" becoming its folder.
 */
import type { GuideView } from "../../../../src/mailbox-do";
import { Button, Icon } from "../ui";
import FolderChip from "./FolderChip.astro";
import { folderView, type FolderView } from "../../lib/mail-data";

interface Props {
  address: string;
  guide: GuideView;
  folders: { id: string; name: string }[];
}
const { address, guide: g, folders } = Astro.props;
const b = `/mb/${encodeURIComponent(address)}`;
const act = (a: string) => `${b}/start/${a}`;

const now = !(g.folderId || g.ruleSkipped) ? 0 : !(g.landed || g.testSkipped) ? 1 : 2;
const STEPS = [
  { t: "Tell Busta what matters", d: `One or two sentences become your ${g.folderName ?? "Must read"} folder.`, href: `${b}/start`, cta: "Start" },
  { t: "Send yourself a test", d: "Watch a message get filed as it arrives.", href: `${b}/start/test`, cta: "Continue" },
  { t: "See where it went", d: "What the labels on each message mean.", href: null, cta: "" },
];

// Step 3: what happened to the test message.
const view = g.landed ? folderView(g.landed, folders) : null;
const pct = (n: number | null | undefined) => `${Math.round((n ?? 0) * 100)}%`;
const mine = g.folderName ?? "Must read";
type Tone = "ok" | "wait" | "info";
let win: { tone: Tone; title: string; body: string; edit?: boolean };
if (!view) {
  win = { tone: "info", title: "Here's how to read your mail.", body: "Each message shows where it went, so you can tell at a glance what Busta did." };
} else if (view.state === "pending") {
  win = { tone: "wait", title: "It arrived. Busta is sorting it…", body: "This usually takes a second or two. The page updates on its own." };
} else if (view.state === "filed" && view.folderId === g.folderId) {
  win = { tone: "ok", title: `It worked. Your message went into ${mine}.`, body: `Busta matched it to your description with ${pct(view.confidence)} confidence and filed it the moment it arrived. It's in Messages too; a folder is just a view.` };
} else if (view.state === "filed") {
  win = { tone: "ok", title: `It arrived and went into ${view.name ?? "another folder"}.`, body: `That folder's rule fit it better than ${mine}. Every message goes to the single best folder.` };
} else if (view.state === "unsure") {
  win = { tone: "info", title: `Busta wasn't sure: ${view.suggestName ?? mine} ${pct(view.confidence)}.`, body: "Below 75% it stays in Messages for you to decide. Choose on the message, and rules won't change your choice.", edit: true };
} else if (view.state === "failed") {
  win = { tone: "info", title: "It arrived, but Busta couldn't sort it.", body: "Use Retry on the message. Nothing is lost; it's in Messages." };
} else if (g.folderId) {
  win = { tone: "info", title: "It arrived and stayed in Messages.", body: `Busta didn't think it matched ${mine}. If it should have, add that to your description.`, edit: true };
} else {
  win = { tone: "info", title: "It arrived in Messages.", body: "Without a folder rule, mail simply lands in Messages. Make a folder any time from New folder." };
}

// Legend chips, drawn by the same component the mail list uses.
const sample = (v: Partial<FolderView>): FolderView => ({
  folderId: null, name: null, source: "rule", state: null, suggestId: null, suggestName: null, confidence: null, probs: null, label: null, ...v,
});
const legend = [
  { chip: sample({ state: "filed", name: mine, folderId: g.folderId, confidence: 0.91 }), text: "Filed by your rule. Open the message to see why, or move it." },
  { chip: sample({ state: "pending" }), text: "Just arrived. Busta is checking it against your rules." },
  { chip: sample({ state: "unsure", suggestName: mine, confidence: 0.52 }), text: "Not sure enough to file. One click decides, and rules won't change your choice." },
  { chip: sample({ state: "filed", source: "you", name: mine }), text: "You filed it yourself. Rules never move it again." },
];
const IDEAS: [string, string][] = [
  ["Bank", "Statements, transfers, balances and alerts from my bank. Not offers for new cards or loans."],
  ["Receipts", "Order confirmations, receipts and shipping updates from stores I bought something from. Not promotions."],
  ["Travel", "Flight, hotel and car rental confirmations, check-in reminders and itinerary changes."],
  ["Newsletters", "Newsletters and digests I subscribed to. Not receipts, and not personal replies."],
];
const idea = ([name, rule]: [string, string]) => `${b}/folders/new?${new URLSearchParams({ name, rule })}`;
---
<div data-live="guide">
  {g.status === "done" && (
    <div class="slim-wrap">
      <form class="slim" method="post" action={act("hide")}>
        <Icon name="check" size={16} />
        <span><b>You're set up.</b> <span class="soft">Getting started is in your account menu if you want it again.</span></span>
        <span class="grow"></span>
        <button class="linkish" type="submit">Hide</button>
      </form>
      <p class="ideas">Next folder ideas:{IDEAS.map((i) => <a class="starter" href={idea(i)}>+ {i[0]}</a>)}</p>
    </div>
  )}

  {g.status === "active" && now < 2 && (
    <section class="guide" aria-label="Getting started">
      <div class="g-head">
        <h2>Welcome to Busta. Let's make your mail sort itself.</h2>
        <span class="count">{now} of 3 done</span>
        <form method="post" action={act("hide")}><Button variant="ghost" size="sm" type="submit">Hide guide</Button></form>
      </div>
      <ol class="steps">
        {STEPS.map((s, i) => (
          <li class:list={["step", { done: i < now, now: i === now }]}>
            <span class="b">{i < now ? <Icon name="check" size={12} /> : i + 1}</span>
            <span class="t"><b>{s.t}</b><span>{s.d}</span></span>
            {i === now && s.href && <Button variant="primary" size="sm" href={s.href}>{s.cta}</Button>}
          </li>
        ))}
      </ol>
      <div class="how">
        <div><b><Icon name="inbox" size={15} />Everything lands in Messages</b><p>There's no inbox to empty. All mail you receive is in Messages.</p></div>
        <div><b><Icon name="tag" size={15} />Folders are sentences</b><p>Each folder has a rule you write in plain English. New mail is filed by it as it arrives.</p></div>
        <div><b><Icon name="lock" size={15} />You always win</b><p>Move a message yourself and rules never move it again.</p></div>
      </div>
    </section>
  )}

  {g.status === "active" && now === 2 && (
    <section class="guide" aria-label="Getting started">
      <div class="win">
        <span class:list={["mark", win.tone]} data-live-pending={win.tone === "wait" ? "" : undefined}>{win.tone === "wait" ? <i class="ring" aria-hidden="true"></i> : <Icon name={win.tone === "ok" ? "check" : "spark"} size={16} />}</span>
        <div class="win-t">
          <h2>{win.title}</h2>
          <p>{win.body}{win.edit && g.folderId && <Fragment> <a href={`${b}/start`}>Edit your description</a></Fragment>}</p>
        </div>
      </div>
      <dl class="legend">
        {legend.map((l) => <div><dt><FolderChip view={l.chip} /></dt><dd>{l.text}</dd></div>)}
      </dl>
      <form class="g-acts" method="post" action={act("finish")}>
        <span class="count">Step 3 of 3</span>
        <span class="grow"></span>
        {g.landed && <Button variant="secondary" size="sm" href={`${b}/${g.landed.id}`}>Open the message</Button>}
        <Button variant="primary" size="sm" type="submit">Finish</Button>
      </form>
    </section>
  )}
</div>

<style>
  .guide { margin: var(--space-3) var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-1); overflow: hidden; }
  .g-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 14px 16px 10px; }
  .g-head h2 { flex: 1; min-width: 14ch; font-size: var(--text-lg); font-weight: 600; }
  .count { font: 500 11px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .steps { list-style: none; margin: 0; padding: 0 16px 14px; display: grid; gap: 2px; }
  .step { display: grid; grid-template-columns: 26px 1fr auto; gap: 10px; align-items: center; padding: 9px 10px; border-radius: var(--radius-md); }
  .step.now { background: var(--primary-soft); }
  .b { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 600 11.5px/1 var(--font-sans); border: 1.5px solid var(--border); color: var(--muted); }
  .now .b { border-color: var(--primary); color: var(--primary); background: var(--surface); }
  .done .b { border-color: var(--success); background: var(--success); color: var(--surface); }
  .t { display: grid; gap: 1px; min-width: 0; }
  .t b { font-weight: 600; }
  .now .t b { color: var(--primary); }
  .done .t b { color: var(--muted); font-weight: 500; }
  .t span { font-size: var(--text-sm); color: var(--muted); }
  .how { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--border); border-top: 1px solid var(--border); }
  .how div { background: var(--surface); padding: 12px 16px; display: grid; gap: 4px; align-content: start; }
  .how b { display: flex; gap: 6px; align-items: center; font-weight: 600; font-size: var(--text-sm); }
  .how p { font-size: var(--text-sm); color: var(--muted); }
  @media (max-width: 900px) { .how { grid-template-columns: 1fr; } }

  .win { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; padding: 14px 16px; }
  .mark { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; }
  .mark.ok { background: var(--success-soft); color: var(--success); }
  .mark.wait { background: var(--warn-soft); color: var(--warn); }
  .mark.info { background: var(--primary-soft); color: var(--primary); }
  .ring { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--warn-fill); border-top-color: transparent; animation: spin .9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .win-t { display: grid; gap: 4px; }
  .win-t h2 { font-size: var(--text-lg); font-weight: 600; }
  .win-t p { color: var(--muted); max-width: 70ch; }
  .legend { display: grid; gap: 8px; margin: 0; padding: 0 16px 14px; }
  .legend div { display: grid; grid-template-columns: 170px 1fr; gap: 10px; align-items: center; font-size: var(--text-sm); color: var(--muted); }
  .legend dd { margin: 0; }
  @media (max-width: 640px) { .legend div { grid-template-columns: 1fr; gap: 4px; } }
  .g-acts { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; padding: 12px 16px; border-top: 1px solid var(--border); }
  .grow { flex: 1; }

  .slim-wrap { margin: var(--space-3) var(--space-4) 0; display: grid; gap: 6px; }
  .slim { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 12px 10px 14px; border-radius: var(--radius-lg); background: var(--success-soft); color: var(--success); }
  .slim b { font-weight: 600; }
  .soft { color: var(--text); opacity: .75; }
  .linkish { font: 600 var(--text-sm) var(--font-sans); background: none; border: 0; color: inherit; cursor: pointer; padding: 4px 8px; border-radius: var(--radius-pill); }
  .linkish:hover { background: var(--surface); }
  .ideas { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; padding: 2px 0 8px; font-size: var(--text-sm); color: var(--muted); }
  .starter { font: 600 12px var(--font-sans); padding: 4px 11px; border-radius: var(--radius-pill); border: 1px dashed var(--border); color: var(--secondary); text-decoration: none; }
  .starter:hover { border-style: solid; color: var(--primary); }
  @media (prefers-reduced-motion: reduce) { .ring { animation: none; } }
</style>
