---
/**
 * The page a one-time link opens (designs/2026-09-25-text-busta, screens 2-3):
 * no app chrome, no scripts, big targets, small enough for a basic phone
 * browser. Never indexed, never cached.
 */
import Base from "../../layouts/Base.astro";
interface Props { title: string }
const { title } = Astro.props;
Astro.response.headers.set("cache-control", "no-store");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
Astro.response.headers.set("referrer-policy", "no-referrer");
---
<Base title={title}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="pub">
    <p class="brand"><span aria-hidden="true">b</span>Busta</p>
    <slot />
  </main>
</Base>

<style>
  .pub { max-width: 560px; margin: 0 auto; padding: 16px 16px 40px; display: grid; gap: 14px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; margin: 0; }
  .brand span { width: 22px; height: 22px; border-radius: 6px; background: var(--primary); color: var(--on-primary); display: grid; place-items: center; font-size: 13px; }
  .pub :global(h1) { font-size: 20px; font-weight: 600; margin: 0; overflow-wrap: anywhere; }
  .pub :global(p) { margin: 0; }
  .pub :global(.muted) { color: var(--muted); font-size: 14px; }
  .pub :global(.big) { display: block; width: 100%; font: 600 17px var(--font-sans); padding: 14px; border-radius: 12px; border: 0; background: var(--primary); color: var(--on-primary); text-align: center; text-decoration: none; cursor: pointer; }
  .pub :global(.plain) { background: var(--surface-2); color: var(--primary); }
  .pub :global(.pin) { font: 600 26px var(--font-mono); letter-spacing: .5em; text-align: center; padding: 10px; width: 100%; border-radius: 12px; border: 1.5px solid var(--border); background: var(--surface); color: var(--text); }
  .pub :global(.pin:focus) { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
  .pub :global(.err) { padding: 10px 12px; border-radius: 10px; background: var(--error-soft); color: var(--error); font-size: 14px; }
  .pub :global(.scope) { padding: 10px 12px; border-radius: 10px; background: var(--surface-2); color: var(--muted); font-size: 13px; }
  .pub :global(form) { display: grid; gap: 10px; margin: 0; }
</style>
