---
/**
 * Inline stroke icons, 24-unit grid. Color comes from `currentColor`, so an
 * icon takes the color of the text around it. `filled` fills shapes that
 * support it (the star) with `--icon-fill`, defaulting to currentColor.
 */
export type IconName =
  | "inbox" | "star" | "file" | "send" | "trash" | "pen" | "spark" | "alert"
  | "search" | "mail" | "clip" | "archive" | "reply" | "check" | "clock" | "tag"
  | "users" | "back" | "more" | "shield" | "forward" | "replyAll";

interface Props {
  name: IconName;
  size?: number;
  filled?: boolean;
  label?: string;
  class?: string;
}

const { name, size = 18, filled = false, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  inbox: "M4 13l2.5-7h11L20 13v5a1 1 0 01-1 1H5a1 1 0 01-1-1z M4 13h4.5l1 2.5h5l1-2.5H20",
  star: "M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z",
  file: "M7 3.5h7l4 4V20a.5.5 0 01-.5.5h-10A.5.5 0 017 20z M14 3.5V8h4",
  send: "M4 12l16-8-6 16-2.5-6.5z M11.5 13.5L20 4",
  trash: "M5 7h14 M9.5 7V4.5h5V7 M7 7l1 13h8l1-13",
  pen: "M4 20l1-4.5L16 4.5l3.5 3.5L8.5 19z M13.5 7l3.5 3.5",
  spark: "M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z",
  alert: "M12 3.5a8.5 8.5 0 110 17 8.5 8.5 0 010-17z M12 7.5v5.5 M12 16.2v.2",
  search: "M10.5 4.5a6 6 0 110 12 6 6 0 010-12z M15 15l5 5",
  mail: "M4 6.5h16v11H4z M4 7l8 6 8-6",
  clip: "M16.5 7.5l-7.8 7.8a2 2 0 102.8 2.8l8-8a4 4 0 10-5.7-5.7l-8 8a6 6 0 108.5 8.5l6.2-6.2",
  archive: "M4 5h16v4H4z M5.5 9v10h13V9 M10 13h4",
  reply: "M10 6L4 12l6 6 M4 12h10a6 6 0 016 6",
  check: "M5 12.5l4.5 4.5L19 7.5",
  clock: "M12 3.5a8.5 8.5 0 110 17 8.5 8.5 0 010-17z M12 7.5V12l3 2",
  tag: "M4 4h7l9 9-7 7-9-9z M8.5 8.5v.1",
  users: "M9 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7z M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5 M16 4.5a3.5 3.5 0 010 6.5 M18 14.8c1.9.7 3 2.6 3 5.2",
  back: "M15 5l-7 7 7 7",
  more: "M6 12h.01 M12 12h.01 M18 12h.01",
  shield: "M12 3.5l7 2.5v5.5c0 4.3-3 7.8-7 9-4-1.2-7-4.7-7-9V6z",
  forward: "M14 6l6 6-6 6 M20 12H10a6 6 0 00-6 6",
  replyAll: "M11 6l-6 6 6 6 M7 6l-6 6 6 6 M5 12h9a6 6 0 016 6",
};
const fillable = name === "star" || name === "spark";
const fill = name === "spark" || (filled && fillable) ? "var(--icon-fill, currentColor)" : "none";
---
<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
><path d={paths[name]} /></svg>

<style>
  .icon { flex-shrink: 0; vertical-align: middle; }
</style>
