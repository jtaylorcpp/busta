---
import Icon from "./Icon.astro";

/**
 * Delivery and workflow state as a small pill. Tones map to meaning, not to
 * color, so callers never pick a color directly:
 *   delivered → success · queued → warn · bounced → error · agent → tertiary
 * The label is required: color never carries the message alone.
 */
export type StatusTone = "delivered" | "queued" | "bounced" | "agent" | "info";

interface Props {
  tone: StatusTone;
  label: string;
  title?: string;
  /** Text and icon only, no pill; for the line under a chat bubble. */
  bare?: boolean;
}
const { tone, label, title, bare = false } = Astro.props;
---
<span class:list={["status", tone, { bare }]} title={title}>
  {tone === "queued" && <i class="dot" aria-hidden="true"></i>}
  {tone === "delivered" && <Icon name="check" size={12} />}
  {tone === "bounced" && <Icon name="alert" size={12} />}
  {tone === "agent" && <Icon name="spark" size={12} />}
  {label}
</span>

<style>
  .status {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: var(--text-xs); font-weight: 600; line-height: 1;
    padding: 4px 8px; border-radius: var(--radius-pill); white-space: nowrap; vertical-align: 1px;
  }
  .delivered { background: var(--success-soft); color: var(--success); }
  .queued { background: var(--warn-soft); color: var(--warn); }
  .bounced { background: var(--error-soft); color: var(--error); }
  .agent { background: var(--tertiary-soft); color: var(--tertiary); }
  .info { background: var(--primary-soft); color: var(--primary); }
  .bare { background: none; padding: 0; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--warn-fill); }
</style>
