---
import Icon, { type IconName } from "./Icon.astro";
import Count from "./Count.astro";

/**
 * Sidebar link. Give either `icon` (system folders) or `tag` (a +tag folder,
 * drawn as a small slate square). `unread` shows in attention red; `total`
 * shows muted when there is nothing unread.
 */
interface Props {
  href: string;
  label: string;
  icon?: IconName;
  tag?: boolean;
  active?: boolean;
  unread?: number;
  total?: number;
}
const { href, label, icon, tag = false, active = false, unread = 0, total = 0 } = Astro.props;
---
<a class:list={["nav-item", { active }]} href={href} aria-current={active ? "page" : undefined}>
  {icon && <Icon name={icon} size={18} />}
  {tag && <span class="sq" aria-hidden="true"></span>}
  <span class="label">{label}</span>
  <span class="n">{unread > 0 ? <Count value={unread} /> : <Count value={total} variant="muted" />}</span>
</a>

<style>
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 7px 14px 7px 16px; border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    color: var(--text); text-decoration: none; font-size: var(--text-md);
  }
  .nav-item:hover { background: var(--surface-2); }
  .active { background: var(--primary-soft); color: var(--primary); font-weight: 600; }
  .active:hover { background: var(--primary-soft); }
  .label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sq { width: 9px; height: 9px; margin-inline: 4px 5px; border-radius: 2px; background: var(--secondary); opacity: .7; }
</style>
