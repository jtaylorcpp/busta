---
import Icon, { type IconName } from "./Icon.astro";
import Count from "./Count.astro";

/**
 * Link tabs across the top of the mail list (All, +triage, …). The active
 * tab is underlined in primary; `unread` renders the red "N new" pill.
 */
interface Tab { label: string; href: string; active?: boolean; unread?: number; icon?: IconName }
interface Props { tabs: Tab[]; label?: string }
const { tabs, label = "Views" } = Astro.props;
---
<nav class="tabs" aria-label={label}>
  {tabs.map((t) => (
    <a href={t.href} class:list={["tab", { on: t.active }]} aria-current={t.active ? "page" : undefined}>
      {t.icon && <Icon name={t.icon} size={15} />}
      {t.label}
      {t.unread ? <Count value={t.unread} variant="pill" suffix="new" /> : null}
    </a>
  ))}
</nav>

<style>
  .tabs { display: flex; gap: 2px; padding: 0 6px; border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; }
  .tab {
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    padding: 11px 12px 9px; border-bottom: 3px solid transparent;
    color: var(--muted); font-weight: 500; text-decoration: none;
  }
  .tab:hover { color: var(--text); background: var(--surface-2); }
  .tab.on { color: var(--primary); border-bottom-color: var(--primary); }
</style>
