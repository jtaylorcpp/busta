---
/**
 * Unread count. `pill` is the filled red badge for tabs; the default is bold
 * red text for nav rows. Renders nothing for zero. `muted` is a plain total.
 */
interface Props {
  value: number;
  variant?: "text" | "pill" | "muted";
  suffix?: string;
}
const { value, variant = "text", suffix } = Astro.props;
---
{value > 0 && <span class:list={["count", variant]}>{value}{suffix ? ` ${suffix}` : ""}</span>}

<style>
  .count { font-size: var(--text-sm); font-variant-numeric: tabular-nums; line-height: 1; }
  .text { color: var(--attention); font-weight: 700; }
  .muted { color: var(--muted); }
  .pill {
    background: var(--attention); color: var(--on-attention);
    font-size: var(--text-xs); font-weight: 700; padding: 3px 7px; border-radius: var(--radius-pill);
  }
</style>
